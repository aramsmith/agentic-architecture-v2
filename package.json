{
  "name": "aff-contract-validator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aff-validate": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsx src/cli.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "14.0.2",
    "fast-glob": "3.3.3",
    "json-canonicalize": "3.0.0",
    "minimatch": "10.2.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
